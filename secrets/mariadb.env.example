# Copy to secrets/mariadb.env and fill in strong values, then `kubectl apply -k kustomize/`.
# This file (without .example) is gitignored. These values seed MariaDB on first boot
# AND build HA's recorder_db_url, so they must match what MariaDB initializes with.
#
# Generate a password with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DATABASE=homeassistant
MYSQL_USER=homeassistant
MYSQL_PASSWORD=CHANGE_ME_ha
