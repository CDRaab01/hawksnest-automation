# Frigate (NVR + object detection) credentials.
# Copy to frigate.env (gitignored) and fill in.
#
# Frigate substitutes these into /config/config.yml as {FRIGATE_FOO} — its
# substitution ONLY works on env vars with the FRIGATE_ prefix, which is why the
# names below look redundant. OPENAI_BASE_URL is the exception and is read by
# Frigate directly, not substituted (see the note further down).

# MQTT password for the `frigate` user on mosquitto.
#
# THIS USER MUST BE APPENDED TO THE EXISTING PASSWD FILE, NOT REGENERATED:
#   mosquitto_passwd -b ~/hawksnest-secrets/mosquitto.passwd frigate '<password>'
#   grep -q '^ring:' ~/hawksnest-secrets/mosquitto.passwd || echo "STOP: dropped ring"
# Rewriting that file drops ring-mqtt's `ring` user and takes every Ring camera
# offline at once. Keep the password URL-safe (no / @ : # ?) for consistency with
# the `ring` user, whose password is embedded in a broker URL.
FRIGATE_MQTT_PASSWORD=replace-with-frigate-mqtt-password

# Reolink RTSP credentials for the camera SUB streams (detect + record).
#
# Deliberately a SEPARATE set from go2rtc's REOLINK_USER/REOLINK_PASS even if you
# use the same camera account: go2rtc reads the MAIN stream on its own connection
# so that a go2rtc restart cannot punch a hole in Frigate's 24/7 timeline. Use a
# dedicated non-admin camera user; keep the password URL-safe, it goes in an
# rtsp:// URL unencoded.
FRIGATE_REOLINK_USER=replace-with-reolink-rtsp-user
FRIGATE_REOLINK_PASSWORD=replace-with-reolink-rtsp-password

# One IP per Reolink camera Frigate records. Give each a DHCP reservation first.
FRIGATE_REOLINK_IP_BIG_ROOM=replace-with-big-room-camera-ip

# --- GenAI (object descriptions) --------------------------------------------
# The endpoint MUST be set here, as an environment variable. Frigate 0.17 IGNORES
# the `base_url` key under `genai:` for the openai provider — configuring it there
# instead silently sends camera snapshots to api.openai.com. Frigate 0.18 is
# expected to honour base_url directly; re-check on upgrade.
#
# This is LM Studio on the Windows host. Under WSL mirrored networking the pod
# reaches the host by its LAN IP, not localhost, and the port needs a Hyper-V
# firewall rule (same shape as HomeAssistant-8123 / Go2rtc-8555 — OPERATIONS.md).
OPENAI_BASE_URL=http://192.168.4.34:1234/v1

# LM Studio ignores the key but the OpenAI client requires a non-empty one.
FRIGATE_GENAI_API_KEY=lm-studio

# MUST be a VISION model — descriptions are generated from snapshot images, so a
# text-only model fails on every event. Use the model id LM Studio reports.
FRIGATE_GENAI_MODEL=replace-with-loaded-vision-model-id
