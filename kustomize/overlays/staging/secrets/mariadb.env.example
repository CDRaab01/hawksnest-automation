# Staging dummy credentials — NOT real. Staging is a throwaway smoke-test
# environment with its own MariaDB on local-path storage, so any values work.
# CI and scripts/deploy.sh materialize the real files from these *.example
# templates for staging (unlike prod, which pulls real secrets from the host).
MYSQL_ROOT_PASSWORD=staging-root-pw
MYSQL_DATABASE=homeassistant
MYSQL_USER=homeassistant
MYSQL_PASSWORD=staging-ha-pw
