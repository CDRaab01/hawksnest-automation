# Mosquitto password file. Do NOT hand-write this — it must be hashed.
#
# Create the real file (secrets/mosquitto.passwd, gitignored) with:
#
#   docker run --rm -it eclipse-mosquitto:2 \
#     sh -c 'touch /tmp/passwd && mosquitto_passwd -b /tmp/passwd <user> <password> && cat /tmp/passwd' \
#     > secrets/mosquitto.passwd
#
# Replace <user>/<password>. You need (at least) a 'ring' account for ring-mqtt and,
# optionally, a 'ratgdo' account for future use. Run mosquitto_passwd once WITHOUT -b's
# create flag per extra user, or -c for the first user only, so all users land in one
# file. The resulting file contains one line per user, like:
#   ring:$7$101$....hashed....
#   ratgdo:$7$101$....hashed....
#
# The 'ring' password here must match RING_MQTT_PASSWORD in secrets/ring-mqtt.env.
