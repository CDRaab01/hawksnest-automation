# ring-mqtt MQTT password. Copy to ring-mqtt.env (gitignored) and fill it in.
#
# This value is embedded in the MQTT broker URL (mqtt://ring:<pw>@mosquitto:1883), so it
# MUST be URL-safe — stick to letters, digits, '-' and '_' (no '/', '@', ':', '#').
#
# It must MATCH the password you set for the 'ring' user in secrets/mosquitto.passwd
# (the broker stores the hash; ring-mqtt sends this plaintext).
RING_MQTT_PASSWORD=replace-with-the-ring-user-password
