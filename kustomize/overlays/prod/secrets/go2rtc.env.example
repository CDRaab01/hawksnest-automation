# Dedicated go2rtc (two-way audio / "talk") credentials + exposure.
# Copy to go2rtc.env (gitignored) and fill in, then `kubectl apply -k kustomize/`.
#
# These are substituted by go2rtc into /config/go2rtc.yaml at runtime (${VAR}).

# Ring account refresh token for go2rtc's native `ring:` source.
#
# IMPORTANT: use a refresh token from a SEPARATE Ring login than ring-mqtt's.
# Ring rotates refresh tokens, and two clients sharing one token will fight and
# invalidate each other's session. Generate this token via go2rtc's web UI
# (Add > Ring) or the ring-client-api auth CLI, distinct from ring-mqtt's.
RING_REFRESH_TOKEN=replace-with-go2rtc-ring-refresh-token

# The host IP that talk clients can actually reach for WebRTC media (the ICE
# candidate go2rtc advertises for :8555). This is the Windows host's TAILSCALE IP
# (or LAN IP). On WSL2, also add a Windows portproxy so this IP:8555 forwards to
# the K3s node:8555 (see the two-way-audio runbook in DEPLOYMENT.md).
GO2RTC_HOST_IP=replace-with-host-tailscale-or-lan-ip

# One Ring device_id per camera you expose in go2rtc-seed configmap. The stream
# name in the configmap MUST match the HA camera base (camera.<base>). Find the
# device_id in go2rtc's web UI (Add > Ring) or in ring-mqtt.
RING_DEVICE_ID_FRONT_DOOR=replace-with-front-door-ring-device-id
RING_DEVICE_ID_FRONT_DRIVEWAY=replace-with-front-driveway-ring-device-id
