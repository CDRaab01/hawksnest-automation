# Dedicated go2rtc (two-way audio / "talk") credentials + exposure.
# Copy to go2rtc.env (gitignored) and fill in, then `kubectl apply -k kustomize/`.
#
# These are substituted by go2rtc into /config/go2rtc.yaml at runtime (${VAR}).

# Ring account refresh token for go2rtc's native `ring:` source.
#
# IMPORTANT: use a refresh token from a SEPARATE Ring login than ring-mqtt's.
# Ring rotates refresh tokens, and two clients sharing one token will fight and
# invalidate each other's session. Generate this token via go2rtc's web UI
# (Add > Ring) or the ring-client-api auth CLI, distinct from ring-mqtt's.
RING_REFRESH_TOKEN=replace-with-go2rtc-ring-refresh-token

# The host IP that talk clients can actually reach for WebRTC media (the ICE
# candidate go2rtc advertises for :8555). This is the Windows host's TAILSCALE IP
# (or LAN IP). On WSL2, also add a Windows portproxy so this IP:8555 forwards to
# the K3s node:8555 (see the two-way-audio runbook in DEPLOYMENT.md).
GO2RTC_HOST_IP=replace-with-host-tailscale-or-lan-ip

# --- Reolink (local RTSP) ---------------------------------------------------
# Credentials for the Reolink cameras' MAIN stream, which go2rtc serves as the
# low-latency live view. Create a DEDICATED, non-admin user on each camera —
# these end up in a URL inside go2rtc's config file, so do not reuse the admin
# login. Keep the password URL-safe (no / @ : # ?) since it is embedded in the
# rtsp:// URL unencoded.
#
# Frigate reads the SUB stream directly from the camera with its own credentials
# (see the frigate-credentials secret) — deliberately a separate path, so a
# go2rtc restart never interrupts 24/7 recording.
REOLINK_USER=replace-with-reolink-rtsp-user
REOLINK_PASS=replace-with-reolink-rtsp-password

# One IP per Reolink camera. Give each camera a DHCP reservation first — go2rtc
# resolves this at boot and a changed IP silently blanks the live view.
REOLINK_IP_BIG_ROOM=replace-with-big-room-camera-ip
REOLINK_IP_FIRST_FLOOR_STAIRWAY=replace-with-stairway-camera-ip
REOLINK_IP_KITCHEN=replace-with-kitchen-camera-ip
REOLINK_IP_NURSERY=replace-with-nursery-camera-ip
REOLINK_IP_NURSERY_HIGH=replace-with-nursery-high-camera-ip
REOLINK_IP_BASEMENT=replace-with-basement-camera-ip
REOLINK_IP_BEDROOM=replace-with-bedroom-camera-ip
REOLINK_IP_GARAGE=replace-with-garage-camera-ip

# --- Ring (cloud) -----------------------------------------------------------
# One Ring device_id per camera you expose in go2rtc-seed configmap. The stream
# name in the configmap MUST match the HA camera base (camera.<base>). Find the
# device_id in go2rtc's web UI (Add > Ring) or in ring-mqtt.
RING_DEVICE_ID_FRONT_DOOR=replace-with-front-door-ring-device-id
RING_DEVICE_ID_FRONT_DRIVEWAY=replace-with-front-driveway-ring-device-id
RING_DEVICE_ID_BASEMENT=replace-me
RING_DEVICE_ID_PUZZLE_ROOM=replace-me
RING_DEVICE_ID_BACK_YARD_PATIO=replace-me
RING_DEVICE_ID_KITCHEN=replace-me
RING_DEVICE_ID_PET_CAMERA=replace-me
RING_DEVICE_ID_BACK_SIDE_YARD=replace-me
RING_DEVICE_ID_FIRST_FLOOR_STAIRWAY=replace-me
RING_DEVICE_ID_BIG_ROOM=replace-me
